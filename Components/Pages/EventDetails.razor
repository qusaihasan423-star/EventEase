

@page "/events/{Id:int}"
@inject EventManagement.Services.UserSession Session

<PageTitle>تفاصيل الفعالية</PageTitle>

@if (Id <= 0)
{
    <h2>رقم الفعالية غير صالح</h2>
    <NavLink href="/events">رجوع للفعاليات</NavLink>
}
else
{
    <h1>تفاصيل الفعالية رقم @Id</h1>
    <NavLink href="/register">سجّل الآن</NavLink>
    <br />
    <NavLink href="/events">رجوع للقائمة</NavLink>

    @if (Session.IsRegistered)
    {
        @if (Session.AttendingEventIds.Contains(Id))
        {
            <p class="text-success">أنت مسجل بهالفعالية ✓</p>
        }
        else
        {
            <button class="btn btn-success" @onclick="() => Session.Attend(Id)">أحضر هالفعالية</button>
        }
    }
    else
    {
        <p>سجّل أولاً عشان تقدر تحضر فعاليات.</p>
    }
}

@code {
    [Parameter] public int Id { get; set; }
}